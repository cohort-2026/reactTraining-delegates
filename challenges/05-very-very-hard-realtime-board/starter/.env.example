# Copy to server/.env (server) and client/.env.local (client) as needed.

# --- server ---
PORT=8787
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-before-deploying
TOKEN_TTL=1h
ALLOWED_ORIGINS=http://localhost:5173

# --- client (Vite only exposes variables that start with VITE_) ---
VITE_SERVER_URL=http://localhost:8787
